/* Theme-native surfaces, one selection accent, semantic failure colors. */
Screen {
    background: $surface;
}

.download-running Header {
    background: $primary-darken-3;
}

.download-attention Header {
    background: $error-darken-3;
}

#sidebar {
    width: 30;
    max-width: 40%;
    min-width: 20;
    border-right: vkey $primary;
    background: $surface-darken-1;
}

#console-list {
    height: 1fr;
    background: $surface-darken-1;
}

Input#filter {
    dock: top;
    margin: 0;
    background: $surface;
}

.class-available { color: $success; }
.class-unavailable { color: $text-muted; text-style: italic; }
.status-acquired { color: $success; }
.status-unverified, .status-pending { color: $text-muted; }
.status-failed { color: $error; }

#main-panel {
    background: $surface;
    padding: 1 2;
    height: 1fr;
    width: 1fr;
}

#main-panel > LoadingIndicator {
    background: $surface;
}

WantlistPreview#main-panel {
    overflow-y: auto;
}

.console-row {
    padding: 0 1;
}

ListView > ListItem.--highlight {
    background: $primary 30%;
}

ListView:focus > ListItem.--highlight {
    background: $primary;
}

ListView > ListItem.--highlight Label {
    color: $text;
}

#browser-title, #dl-title, #st-title {
    height: auto;
    width: 1fr;
    text-style: bold;
    margin-bottom: 1;
}

#browser-context, #progress-context, #st-summary {
    height: auto;
    width: 1fr;
    color: $text-muted;
    margin-bottom: 1;
}

#status-line, #summary-line {
    height: auto;
    width: 1fr;
    margin-bottom: 1;
}

#wantlist-table, #state-table {
    height: 1fr;
    min-height: 5;
    background: $surface-darken-1;
}

#wantlist-preview {
    height: 1fr;
    border: none;
    padding: 0 1;
    background: $surface-darken-1;
}

#progress-overall {
    height: auto;
    margin: 1 0;
}

#progress-overall-bar {
    width: 1fr;
}

#progress-overall-bar Bar {
    width: 1fr;
}

#progress-overall-bar Bar > .bar--bar,
#progress-overall-bar Bar > .bar--complete {
    background: $surface-lighten-3;
}

#progress-overall-bar Bar > .bar--complete {
    color: $primary;
}

#progress-active, #progress-completed, .dl-active-row,
.dl-active-title, .dl-active-metrics, .dl-status-row,
#progress-empty, #progress-detail-text {
    height: auto;
    width: 1fr;
}

.dl-active-row, .dl-status-row {
    margin-bottom: 1;
}

.dl-active-title {
    text-style: bold;
}

.dl-active-metrics, #progress-empty, #progress-detail-text {
    color: $text-muted;
}

.dl-section-title {
    color: $text-muted;
    text-style: bold;
    margin: 1 0;
}

#progress-details {
    margin: 1 0 0 0;
    border: none;
    padding: 0;
    background: $surface;
}

#history-details-pane {
    height: auto;
    max-height: 10;
    margin-top: 1;
}

#history-details, #game-detail {
    height: auto;
    width: 1fr;
}

#game-detail {
    color: $text-muted;
    margin-top: 1;
}

CancelConfirmScreen, HelpScreen {
    align: center middle;
    background: $background 60%;
}

#cancel-confirm-modal {
    width: 60;
    max-width: 95%;
    height: auto;
    border: solid $warning;
    background: $surface;
    padding: 1 2;
}

#cancel-confirm-question {
    height: auto;
    width: 1fr;
    margin-bottom: 1;
}

#help-panel {
    width: 80;
    max-width: 95%;
    height: 85%;
    border: solid $primary;
    background: $surface;
    padding: 1 2;
}

#help-title {
    text-style: bold;
}

#help-scroll {
    height: 1fr;
    margin: 1 0;
}

#help-footer, #cancel-confirm-actions {
    height: auto;
    width: 1fr;
    color: $text-muted;
}
