/* retrofetch TUI styles - dark theme, ASCII-safe (no emoji, no box-drawing).
 * Colors come from Textual's built-in theme variables so they adapt if a user
 * switches between dark/light variants. Only structural rules here.
 */

Screen {
    background: $surface;
}

#sidebar {
    width: 32;
    border-right: vkey $primary;
    background: $surface-darken-1;
}

#console-list {
    height: 1fr;
    background: $surface-darken-1;
}

Input#filter {
    dock: top;
    border: round $primary;
    background: $surface;
    margin: 0;
}

/* Simplified availability coloring. A console is "available" iff:
 *   class is A/B/C AND it has at least one ranking-source slug populated
 *   (romsfun_slug, romsretro_slug, archive_org_identifier, vimm_slug,
 *   coolrom_slug).
 * Anything else (class D/E/F, or Class A/B/C with no provider) is
 * unavailable - shown dim + italic so the user knows not to expect games.
 */
.class-a { color: $success; }
.class-b { color: $success; }
.class-c { color: $success; }
.class-available   { color: $success; }
.class-unavailable { color: $text-muted; text-style: italic; }

/* Status colors for downstream screens (state browser, download progress, etc.). */
.status-acquired  { color: $success; }
.status-unverified { color: $warning; }
.status-failed    { color: $error; }
.status-pending   { color: $text-muted; }

/* Main content panel. */
#main-panel {
    background: $surface;
    padding: 1 2;
    width: 1fr;
}

/* Ensure list rows have some breathing room and a highlight on focus. */
.console-row {
    padding: 0 1;
}
ListView > ListItem.--highlight {
    background: $accent 50%;
}

/* Download flow screens — Confirm, Progress, and Cancel modal.
 * IDs and classes are referenced by:
 *   download_confirm.py    — #dl-title, #summary-line, #dry-run-toggle, #wantlist-preview
 *   download_progress.py   — #dl-title, #summary-line, #progress-overall, #progress-overall-bar,
 *                            #progress-active, #progress-completed, .dl-active-row,
 *                            .dl-status-row, .dl-section-title
 *   cancel_confirm.py      — CancelConfirmScreen, #cancel-confirm-modal,
 *                            #cancel-confirm-question, #cancel-confirm-actions
 */

#dl-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

#summary-line {
    color: $text;
    margin-bottom: 1;
}

#dry-run-toggle {
    margin-bottom: 1;
}

#wantlist-preview {
    height: 1fr;
    border: round $primary;
    padding: 0 1;
    background: $surface-darken-1;
}

#progress-overall {
    height: auto;
    padding: 0 1;
    margin-bottom: 1;
    border: round $accent;
}

#progress-overall-bar {
    width: 1fr;
}

#progress-active {
    height: auto;
    max-height: 8;
    padding: 0 1;
    margin-bottom: 1;
}

#progress-completed {
    height: 1fr;
    padding: 0 1;
    border-top: solid $surface;
    margin-top: 1;
}

.dl-active-row {
    color: $warning;
}

.dl-status-row {
    padding: 0 1;
}

.dl-section-title {
    color: $text-muted;
    text-style: bold;
    margin-top: 1;
}

CancelConfirmScreen {
    align: center middle;
}

CancelConfirmScreen #cancel-confirm-modal {
    width: 50;
    height: 9;
    border: round $error;
    background: $surface;
    padding: 1 2;
}

#cancel-confirm-question {
    text-align: center;
    margin-bottom: 1;
}

#cancel-confirm-actions {
    text-align: center;
}
